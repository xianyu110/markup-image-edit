# Static asset cache — long CDN/browser TTL so media/icons stay on Assets.
# /assets/* hashed bundles are immutable; samples/posters change rarely.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/samples/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/audio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/badges/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/imgs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/related-tools/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/logo.png
  Cache-Control: public, max-age=86400

/logo.svg
  Cache-Control: public, max-age=86400

/og.jpg
  Cache-Control: public, max-age=86400

/og-*.jpg
  Cache-Control: public, max-age=86400

/og-*.png
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=86400

/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=86400

/llms.txt
  Cache-Control: public, max-age=3600, s-maxage=86400

/llms-full.txt
  Cache-Control: public, max-age=3600, s-maxage=86400

/examples/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
